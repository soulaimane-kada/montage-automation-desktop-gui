   <property name="styleSheet">
    <string notr="true">/*  sections styles */
#section1, #section2, #section3, #section4, #section5, #section6 {
	background-color: #DDDDDD;
	border-radius: 5px;
}

/*  Splitter styles */
QSplitter::handle {
    background-color: none;
}

/*  Text styles */
QLabel {
	min-height: 30px;
	max-height: 30px;
	border-radius: 5px;
}

#FrameImage, #FrameImage2 {
	width: 340px;
	height: 190px;
	border-radius: 5px;
	max-width: 640px;
	max-height: 480px;
}

/*  Plain Text styles */
QPlainTextEdit {
	background-color: #fff;
	color: #000;
	border-radius: 5px;
	padding: 5px;
}

/*  buttons styles */
QPushButton {
	background-color: rgb(0, 0, 0);
	color: rgb(255, 255, 255);
	border-radius: 5px;
	min-width: 150px;
	min-height: 30px;
	max-height: 30px;
}

QPushButton:hover {
	background-color: #333333;
}

#PriviewFrameButton, #PriviewFrameButton2 {
	max-width: 340px;
}

/*  input  styles */
QLineEdit {
	background-color: rgb(255, 255, 255);
	padding-left: 10px;
	border: 0px;
	border-radius: 5px;
	min-width: 330px;
	min-height: 30px;
	max-height: 30px;
}


/*  combbobox styles */
QComboBox {
    background-color: #000;
	color: white;
	border-radius: 5px;
	padding-left: 10px;
	min-height: 30px;
	min-width: 155px;
	max-width: 160px;
	max-height: 30px;
}

#TranscriptType {
	max-width: 150px;
}

#TransparentInput {
	min-width: 330px;
	max-width: 330px;
}

#TransparentInput2, #AlbumNameInput2, #AlbumNameInput3, #TranslationToInput2, #ArtistGender {
	max-width: 16777215px;
}

#AlbumNameInput2, #AlbumNameInput3 {
	border-top-right-radius: 0px;
	border-bottom-right-radius: 0px;
	min-width: 100px;
}

#FontSizeWord1, #FontSizeWord2 {
	border-top-left-radius: 0px;
	border-bottom-left-radius: 0px;
}

QComboBox:hover {
    background-color: #333333 ;
}

QComboBox::down-arrow {
    image: url(ui/icons/arrow-down.png);
	width: 10px;
	height: 10px;
}

QComboBox::drop-down {
	background-color: #000;
    subcontrol-origin: padding;
    subcontrol-position: right center;
	border-top-right-radius: 5px;
	border-bottom-right-radius: 5px;
	width: 30px;
}

QComboBox::drop-down:hover {
	background-color: #333333  ;
}

QComboBox QAbstractItemView {
    background-color: white;
    color: black;
    border: 1px solid #000;
    selection-background-color: #333333;
}

QComboBox:disabled {
    background-color: #6D55FF;
    color: #fff;
}
</string>
