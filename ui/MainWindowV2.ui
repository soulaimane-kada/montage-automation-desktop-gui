   <property name="styleSheet">
    <string notr="true">#section1, #section2, #section3, #section4 {
	background-color: #E5E4E2;
}

/*  input  styles */
QLineEdit {
	background-color: rgb(255, 255, 255);
	padding-left: 10px;
	border: 0px;
	border-radius: 5px;
	min-height: 30px;
	max-height: 30px;
}

/*  Plain Text styles */
QPlainTextEdit {
	background-color: #fff;
	color: #000;
	border-radius: 5px;
	padding: 5px;
}

/*  buttons styles */
QPushButton {
	background-color: rgb(0, 0, 0);
	color: rgb(255, 255, 255);
	border-radius: 5px;
	min-height: 30px;
	max-height: 30px;
}

QPushButton:hover, QPushButton:disabled {
	background-color: #333333;
}

/*  combbobox styles */
QComboBox {
    background-color: #000;
	color: white;
	border-radius: 5px;
	padding-left: 10px;
	min-height: 30px;
	max-height: 30px;
}

QComboBox:hover {
    background-color: #333333 ;
}

QComboBox::down-arrow {
    image: url(assets/icons/arrow-down.png);
	width: 10px;
	height: 10px;
}

QComboBox::drop-down {
	background-color: #000;
    subcontrol-origin: padding;
    subcontrol-position: right center;
	border-top-right-radius: 5px;
	border-bottom-right-radius: 5px;
	width: 30px;
}

QComboBox::drop-down:hover {
	background-color: #333333  ;
}

QComboBox QAbstractItemView {
    background-color: white;
    color: black;
    border: 1px solid #000;
    selection-background-color: #333333;
}

QComboBox:disabled {
    background-color: #333333;
    color: #fff;
}</string>
